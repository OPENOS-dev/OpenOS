{
  "chromeos": {
    "configs": [
      {
        "arc": {
          "build-properties": {
            "device": "hades_cheets",
            "marketing-name": "",
            "metrics-tag": "hades",
            "product": "hades"
          },
          "hardware-features": {
            "build-path": "hades/public_sw_build_config/platform/chromeos-config/generated/arc/hardware_features_hades.xml",
            "system-path": "/etc/hardware_features_hades.xml"
          }
        },
        "audio": {
          "main": {
            "cras-config-dir": "hades",
            "files": [
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.hades/HiFi.conf",
                "source": "hades/audio/ucm-config/sof-rt5682.hades/HiFi.conf"
              },
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.hades/sof-rt5682.hades.conf",
                "source": "hades/audio/ucm-config/sof-rt5682.hades/sof-rt5682.conf"
              },
              {
                "destination": "/etc/cras/hades/sof-rt5682",
                "source": "hades/audio/cras-config/card_settings"
              },
              {
                "destination": "/etc/cras/hades/dsp.ini",
                "source": "hades/audio/cras-config/dsp.ini"
              },
              {
                "destination": "/etc/modprobe.d/alsa-hades.conf",
                "source": "alsa-module-config/alsa-hades.conf"
              },
              {
                "destination": "/etc/cras/hades/board.ini",
                "source": "hades/audio/cras-config/board.ini"
              }
            ],
            "ucm-suffix": "hades"
          }
        },
        "bluetooth": {
          "flags": {
            "enable-bluetooth-offload": true
          }
        },
        "camera": {
          "count": 0
        },
        "firmware": {
          "bcs-overlay": "overlay-hades-private",
          "build-targets": {
            "ec": "hades"
          },
          "firmware-config": 0
        },
        "hardware-properties": {
          "storage-type": "STORAGE_TYPE_UNKNOWN",
          "stylus-category": "unknown"
        },
        "identity": {
          "frid": "Google_Hades",
          "platform-name": "Hades",
          "sku-id": 2147483647
        },
        "name": "hades",
        "power": {
          "defer-external-display-timeout": "10",
          "disable-dark-resume": "0",
          "low-battery-shutdown-percent": "4.0",
          "suspend-to-idle": "1"
        },
        "pvs": {
          "program": "hades",
          "project": "hades"
        },
        "ui": {
          "extra-ash-flags": [
            "--arc-build-properties={'device': 'hades_cheets', 'firstApiLevel': '28'}",
            "--child-wallpaper-large=/usr/share/chromeos-assets/wallpaper/child_large.jpg",
            "--child-wallpaper-small=/usr/share/chromeos-assets/wallpaper/child_small.jpg",
            "--default-wallpaper-large=/usr/share/chromeos-assets/wallpaper/default_large.jpg",
            "--default-wallpaper-small=/usr/share/chromeos-assets/wallpaper/default_small.jpg",
            "--guest-wallpaper-large=/usr/share/chromeos-assets/wallpaper/guest_large.jpg",
