load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "dut_proto",
    srcs = ["device_stability.proto"],
    visibility = ["//visibility:public"],
    deps = ["//chromiumos/test/api:api_proto"],
)

go_proto_library(
    name = "dut_go_proto",
    importpath = "go.chromium.org/chromiumos/config/go/test/dut",
    proto = ":dut_proto",
    visibility = ["//visibility:public"],
    deps = ["//chromiumos/test/api"],
)

go_library(
    name = "dut",
    embed = [":dut_go_proto"],
    importpath = "go.chromium.org/chromiumos/config/go/test/dut",
    visibility = ["//visibility:public"],
)
