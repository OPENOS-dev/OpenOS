load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "_go_proto",
    srcs = ["storage_path.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "_go_go_proto",
    importpath = "go.chromium.org/chromiumos/config/go",
    proto = ":_go_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "go",
    embed = [":_go_go_proto"],
    importpath = "go.chromium.org/chromiumos/config/go",
    visibility = ["//visibility:public"],
)
