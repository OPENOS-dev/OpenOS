[MAIN]

init-hook='import sys; sys.path.append("presubmit")'

load-plugins=
    pylint.extensions.no_self_use,

[MESSAGES CONTROL]

disable=
    consider-using-f-string,
    possibly-used-before-assignment,

[REPORTS]

score=no
