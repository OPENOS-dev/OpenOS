# Maintainer: Isaac Bosompem <mrisaacb@google.com>

pkgname=cpuid
pkgver=20240324
pkgrel=1
pkgdesc="cpuid tool"
url="http://www.etallen.com/cpuid.html"
license=('GPL')
arch=('x86_64')
depends=('glibc')
source=("http://commondatastorage.googleapis.com/chromeos-localmirror/distfiles/${pkgname}-${pkgver}.src.tar.gz")
sha256sums=('ddfbc5b9d80151bb04975e9dec1305103419798d22eff2e2449083dc0862184c')

build() {
    cd "$srcdir/${pkgname}-${pkgver}"

    make "${pkgname}"
}

package() {
    cd "$srcdir/${pkgname}-${pkgver}"

    install -D "$srcdir/${pkgname}-${pkgver}/cpuid" "$pkgdir/usr/bin/${pkgname}"
}
