filegroup(
    name = "srcs",
    srcs = glob(["**"]),
)

py_library(
    name = "py_deps",
    deps = [
        "@hdctools_py_deps_numpy//:pkg",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "dut_control",
    srcs = [":srcs"],
    deps = [":py_deps"],
    main = "//:servo/dut_control.py",
    visibility = ["//visibility:public"],
)
