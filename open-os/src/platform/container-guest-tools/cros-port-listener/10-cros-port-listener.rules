# This udev rule is used by systemd to satisfy the `dev-vsock.device`
# Wants/After fields in cros-port-listener.service. This ensures the service
# isn't started until the kernel's vsock subsystem is running. Otherwise the
# service can fail to start when it tries to create the vsock socket.

KERNEL=="vsock", TAG+="systemd"
