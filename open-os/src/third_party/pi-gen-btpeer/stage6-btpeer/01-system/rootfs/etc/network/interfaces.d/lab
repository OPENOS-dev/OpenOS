# Network configuration file for ifup(8), ifdown(8)
# https://wiki.debian.org/NetworkConfiguration
# See "man interfaces" for option documentation.

# Allow IPv4 loopback.
auto lo
iface lo inet loopback

# Ethernet should be on and use lab dhcp.
auto eth0
iface eth0 inet dhcp
allow-hotplug eth0
