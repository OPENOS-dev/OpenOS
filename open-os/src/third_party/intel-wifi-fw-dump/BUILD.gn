import("//common-mk/pkg_config.gni")

group("all") {
  deps = [
    ":iwlwifi_dump_processor",
  ]
}

pkg_config("config") {
  pkg_deps = [
    "libbrillo",
    "libchrome",
    "libminijail",
  ]
}

executable("iwlwifi_dump_processor") {
  configs += [ ":config" ]

  sources = [
    "sandbox/iwlwifi_dump_processor.cc",
  ]
}
