@@ -31,7 +31,7 @@ static inline void* bsearch_safe(const void *key, const void *base,
                 return NULL;
 
         assert(base);
-        return bsearch(key, base, nmemb, size, compar);
+        return (void*) bsearch(key, base, nmemb, size, compar);
 }
 
