From: Peter Marheine <pmarheine@chromium.org>
Date: Wed, 24 Jan 2024 11:17:57 +1100
Subject: [PATCH] tests: use $CC, not hard-coded gcc

Cross-compiling may need to use a different compiler, so don't hard code
references to plain `gcc` and instead determine the compiler to use from
the environment.
---
diff -ur a/tests/common.mak b/tests/common.mak
--- a/tests/common.mak	2024-04-01 16:07:46.000000000 +0000
+++ b/tests/common.mak	2024-07-29 18:05:33.011201103 +0000
@@ -68,7 +68,7 @@
 
 # Specify size for artificial info files (small, medium, large)
 SIZE         := small
-CC           := gcc
+export CC    ?= gcc
 
 export LCOV_TOOL := $(EXEC_COVER) $(BINDIR)/lcov
 export GENHTML_TOOL := $(EXEC_COVER) $(BINDIR)/genhtml
Only in b/tests: common.mak.orig
diff -ur a/tests/gendiffcov/insensitive/insensitive.sh b/tests/gendiffcov/insensitive/insensitive.sh
--- a/tests/gendiffcov/insensitive/insensitive.sh	2024-02-13 19:17:46.000000000 +0000
+++ b/tests/gendiffcov/insensitive/insensitive.sh	2024-07-29 18:05:33.015201529 +0000
@@ -6,7 +6,8 @@
 
 PARALLEL='--parallel 0'
 PROFILE="--profile"
-CXX='g++'
+CC="${CC:-gcc}"
+CXX="${CXX:-g++}"
 COVER_DB='cover_db'
 LOCAL_COVERAGE=1
 KEEP_GOING=0
@@ -144,7 +145,7 @@
 echo `which lcov`
 
 # old gcc version generates inconsistent line/function data
-IFS='.' read -r -a VER <<< `gcc -dumpversion`
+IFS='.' read -r -a VER <<< `${CC} -dumpversion`
 if [ "${VER[0]}" -lt 5 ] ; then
     IGNORE="--ignore inconsistent"
 fi
