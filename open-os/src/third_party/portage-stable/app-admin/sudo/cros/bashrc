cros_post_src_install_install_mask() {
	# chromeos-base/chromeos-auth-config installs these files.
	if use pam; then
		rm -v "${ED}"/etc/pam.d/sudo{,-i} || die
	fi

	# We don't need to init these dirs.
	rm -v "${ED}"/usr/lib/tmpfiles.d/sudo.conf || die
}
