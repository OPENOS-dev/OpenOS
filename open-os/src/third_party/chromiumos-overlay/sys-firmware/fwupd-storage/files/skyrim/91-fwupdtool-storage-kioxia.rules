# udev rules to start firmware update for NVME SSD: Kioxia
SUBSYSTEM=="nvme", \
ATTRS{vendor}=="0x1e0f", \
ATTR{firmware_rev}!="12000102", \
ATTR{model}=="BG6 KIOXIA 256GB", \
ACTION=="add", \
RUN+="/sbin/initctl emit fwupdtool-update PLUGIN=nvme GUID=6cbe1efe-825a-11ed-a1eb-0242ac120002"
