CONFIG_VENDOR_GOOGLE=y
CONFIG_BOARD_GOOGLE_PUJJOLO=y
CONFIG_MAINBOARD_PART_NUMBER="Pujjolo"

# Enable Early Splash Screen
CONFIG_CHROMEOS_FW_SPLASH_SCREEN=n

# TWL FSP blobs
CONFIG_FSP_M_FILE="3rdparty/blobs/intel/twl/fsp/fspm.bin"
CONFIG_FSP_S_FILE="3rdparty/blobs/intel/twl/fsp/fsps.bin"

# SPI Descriptor
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/google/nissa/descriptor-pujjolo.bin"

# Management Engine
CONFIG_ME_BIN_PATH="3rdparty/blobs/mainboard/google/nissa/csme-pujjolo.bin"

# Management Engine FW update
CONFIG_SOC_INTEL_CSE_RW_FILE="3rdparty/blobs/mainboard/google/nissa/me_rw-pujjolo.bin"
CONFIG_LOCK_MANAGEMENT_ENGINE=n

# Video Blob
CONFIG_INTEL_GMA_VBT_FILE="3rdparty/blobs/mainboard/google/nissa/vbt-pujjolo.bin"

# Microcode
CONFIG_CPU_UCODE_BINARIES="3rdparty/blobs/mainboard/google/nissa/ucode-pujjolo.bin"

# CSE Lite RW Version
CONFIG_SOC_INTEL_CSE_RW_VERSION="16.50.22.1715"
