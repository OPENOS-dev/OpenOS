CONFIG_VENDOR_GOOGLE=y
CONFIG_BOARD_GOOGLE_XOL=y

# FW Splash Screen
CONFIG_CHROMEOS_FW_SPLASH_SCREEN=y
CONFIG_CHROMEOS_LOGO_PATH="bootsplash_assets/chromeos_100_percent.bmp"
CONFIG_CHROMEBOOK_PLUS_LOGO_PATH="bootsplash_assets/chromebook_plus_100_percent.bmp"

# SPI Descriptor
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/google/brya/descriptor-xol.bin"

# CSE data
CONFIG_ME_BIN_PATH="3rdparty/blobs/mainboard/google/brya/csme-xol.bin"
CONFIG_SOC_INTEL_CSE_RW_FILE="3rdparty/blobs/mainboard/google/brya/me_rw-xol.bin"
CONFIG_SOC_INTEL_CSE_RW_UPDATE=y
CONFIG_SOC_INTEL_CSE_RW_VERSION="16.1.38.2713"

# FSP Blobs
CONFIG_FSP_HEADER_PATH="3rdparty/blobs/intel/rpl/fsp/Include"
CONFIG_FSP_M_FILE="3rdparty/blobs/intel/rpl/fsp/fspm.bin"
CONFIG_FSP_S_FILE="3rdparty/blobs/intel/rpl/fsp/fsps.bin"

# Video Blob
CONFIG_INTEL_GMA_VBT_FILE="3rdparty/blobs/mainboard/google/brya/vbt-xol.bin"

# Microcode
CONFIG_CPU_UCODE_BINARIES="3rdparty/blobs/mainboard/google/brya/ucode-xol.bin"
