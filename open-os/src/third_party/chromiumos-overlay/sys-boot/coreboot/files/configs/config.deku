CONFIG_VENDOR_GOOGLE=y
CONFIG_BOARD_GOOGLE_DEKU=y

# SPI Descriptor
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/google/rex/descriptor-deku.bin"

# CSE data
# CONFIG_CSE_DATA_FILE="cse_data/cse_data-deku.bin"
CONFIG_ME_BIN_PATH="3rdparty/blobs/mainboard/google/rex/csme-deku.bin"
CONFIG_SOC_INTEL_CSE_RW_FILE="3rdparty/blobs/mainboard/google/rex/me_rw-deku.bin"

# Video Blob
CONFIG_INTEL_GMA_VBT_FILE="3rdparty/blobs/mainboard/google/rex/vbt-deku.bin"

# Microcode
CONFIG_CPU_INTEL_UCODE_SPLIT_BINARIES="3rdparty/blobs/mainboard/google/rex/microcode_inputs/deku"
