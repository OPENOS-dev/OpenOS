CONFIG_VENDOR_GOOGLE=y
CONFIG_BOARD_GOOGLE_KINMEN=y
CONFIG_VBOOT_FWID_MODEL="Google_Kinmen"

# SPI Descriptor
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/google/fatcat/descriptor-kinmen.bin"

CONFIG_PLATFORM_LOW_BATTERY_INDICATOR_LOGO_PATH="bootsplash_assets/battery_low_100_percent.bmp"

# CSE data
# CONFIG_CSE_DATA_FILE="cse_data/cse_data-kinmen.bin"
CONFIG_ME_BIN_PATH="3rdparty/blobs/mainboard/google/fatcat/csme-kinmen.bin"
CONFIG_SOC_INTEL_CSE_RW_FILE="3rdparty/blobs/mainboard/google/fatcat/me_rw-kinmen.bin"

# Video Blob
CONFIG_INTEL_GMA_VBT_FILE="3rdparty/blobs/mainboard/google/fatcat/vbt/vbt-kinmen.bin"

# Microcode
CONFIG_CPU_INTEL_UCODE_SPLIT_BINARIES="3rdparty/blobs/mainboard/google/fatcat/microcode_inputs/kinmen"
