CONFIG_VENDOR_GOOGLE=y
CONFIG_BOARD_GOOGLE_DOMIKA=y
CONFIG_MAINBOARD_PART_NUMBER="Domika"

# TWL FSP blobs
CONFIG_FSP_M_FILE="3rdparty/blobs/intel/twl/fsp/fspm.bin"
CONFIG_FSP_S_FILE="3rdparty/blobs/intel/twl/fsp/fsps.bin"
CONFIG_FSP_HEADER_PATH="3rdparty/blobs/intel/twl/fsp/FullHeader/Include/"

# FW Splash Screen
CONFIG_CHROMEOS_FW_SPLASH_SCREEN=y
CONFIG_CHROMEOS_LOGO_PATH="bootsplash_assets/chromeos_100_percent.bmp"
CONFIG_CHROMEBOOK_PLUS_LOGO_PATH="bootsplash_assets/chromebook_plus_100_percent.bmp"

# SPI Descriptor
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/google/nissa/descriptor-domika.bin"

# Management Engine
CONFIG_ME_BIN_PATH="3rdparty/blobs/mainboard/google/nissa/csme-domika.bin"

# Management Engine FW update
CONFIG_SOC_INTEL_CSE_RW_FILE="3rdparty/blobs/mainboard/google/nissa/me_rw-domika.bin"

# Video Blob
CONFIG_INTEL_GMA_VBT_FILE="3rdparty/blobs/mainboard/google/nissa/vbt-domika.bin"

# Microcode
CONFIG_CPU_UCODE_BINARIES="3rdparty/blobs/mainboard/google/nissa/ucode-domika.bin"

# CSE Lite RW Version
CONFIG_SOC_INTEL_CSE_RW_VERSION="16.50.22.1715"
