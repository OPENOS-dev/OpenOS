CONFIG_VENDOR_GOOGLE=y
CONFIG_BOARD_GOOGLE_FRANCKA=y
CONFIG_VBOOT_FWID_MODEL="Google_Francka"


# SPI Descriptor
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/google/fatcat/descriptor-francka.bin"

# CSE data
# CONFIG_CSE_DATA_FILE="cse_data/cse_data-francka.bin"
CONFIG_ME_BIN_PATH="3rdparty/blobs/mainboard/google/fatcat/csme-francka.bin"
CONFIG_SOC_INTEL_CSE_RW_FILE="3rdparty/blobs/mainboard/google/fatcat/me_rw-francka.bin"

# Video Blob
CONFIG_INTEL_GMA_VBT_FILE="3rdparty/blobs/mainboard/google/fatcat/vbt/vbt-francka.bin"

# Microcode
CONFIG_CPU_INTEL_UCODE_SPLIT_BINARIES="3rdparty/blobs/mainboard/google/fatcat/microcode_inputs/francka"
