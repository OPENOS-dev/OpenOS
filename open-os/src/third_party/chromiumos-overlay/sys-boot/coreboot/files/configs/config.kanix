CONFIG_VENDOR_GOOGLE=y
CONFIG_BOARD_GOOGLE_KANIX=y

CONFIG_CHROMEOS_LOGO_PATH="bootsplash_assets/chromeos_200_percent.bmp"
CONFIG_CHROMEBOOK_PLUS_LOGO_PATH="bootsplash_assets/chromebook_plus_200_percent.bmp"

# SPI Descriptor
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/google/rex/descriptor-kanix.bin"

# CSE data
# CONFIG_CSE_DATA_FILE="cse_data/cse_data-rex0.bin"
CONFIG_ME_BIN_PATH="3rdparty/blobs/mainboard/google/rex/csme-kanix.bin"
CONFIG_SOC_INTEL_CSE_RW_FILE="3rdparty/blobs/mainboard/google/rex/me_rw-kanix.bin"

# Video Blob
CONFIG_INTEL_GMA_VBT_FILE="3rdparty/blobs/mainboard/google/rex/vbt-kanix.bin"

# Microcode
CONFIG_CPU_INTEL_UCODE_SPLIT_BINARIES="3rdparty/blobs/mainboard/google/rex/microcode_inputs/kanix"
