CONFIG_PAYLOAD_NONE=y
CONFIG_USE_BLOBS=y

# Chrome OS
CONFIG_CHROMEOS=y

# SPI Descriptor
CONFIG_HAVE_IFD_BIN=y

# FSP Blobs
CONFIG_ADD_FSP_BINARIES=y
CONFIG_FSP_M_FILE="3rdparty/blobs/intel/ptl/fsp/release/fspm.bin"
CONFIG_FSP_S_FILE="3rdparty/blobs/intel/ptl/fsp/release/fsps.bin"
CONFIG_FATCAT_VGA_MODE12_SUPPORT=y
CONFIG_RUN_FSP_GOP=y

# Management Engine
CONFIG_HAVE_ME_BIN=y

# Microcode
CONFIG_CPU_INTEL_MICROCODE_CBFS_SPLIT_BINS=y

# Video Blob
CONFIG_INTEL_GMA_ADD_VBT=y

# Enable Early Splash Screen
CONFIG_CHROMEOS_FW_SPLASH_SCREEN=y
CONFIG_CHROMEOS_LOGO_PATH="bootsplash_assets/oem_main_logo/d3556d78/logo_100_percent.bmp"
CONFIG_CHROMEBOOK_PLUS_LOGO_PATH="bootsplash_assets/oem_main_logo/d3556d78/logo_100_percent.bmp"

# Enable Low Battery Indicator (UI and Text Mode)
CONFIG_PLATFORM_HAS_LOW_BATTERY_INDICATOR=y
CONFIG_PLATFORM_LOW_BATTERY_INDICATOR_LOGO_PATH="bootsplash_assets/low_battery_100_percent.bmp"
CONFIG_PLATFORM_HAS_EARLY_LOW_BATTERY_INDICATOR=y

# Enable Text based splash screen
CONFIG_FRAMEBUFFER_SPLASH_TEXT=y

# Serial console disabled by default (do not remove)
# CONFIG_CONSOLE_SERIAL is not set

# Event Logging
CONFIG_ELOG_GSMI=y
CONFIG_ELOG_BOOT_COUNT=y
CONFIG_ELOG_BOOT_COUNT_CMOS_OFFSET=144
CONFIG_SPI_FLASH_SMM=y

# Management Engine FW update
CONFIG_SOC_INTEL_CSE_RW_UPDATE=y

# FILEPATH is set to blank to prevent any default SAR file from getting added.
CONFIG_WIFI_SAR_CBFS_FILEPATH=""
