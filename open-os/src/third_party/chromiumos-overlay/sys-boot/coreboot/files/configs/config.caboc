CONFIG_VENDOR_GOOGLE=y
CONFIG_BOARD_GOOGLE_CABOC=y

# SPI Descriptor
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/google/brox/descriptor-caboc.bin"

# CSE data
CONFIG_ME_BIN_PATH="3rdparty/blobs/mainboard/google/brox/csme-caboc.bin"
CONFIG_SOC_INTEL_CSE_RW_FILE="3rdparty/blobs/mainboard/google/brox/me_rw-caboc.bin"

# Video Blob
CONFIG_INTEL_GMA_VBT_FILE="3rdparty/blobs/mainboard/google/brox/vbt-caboc.bin"

# Microcode
CONFIG_CPU_UCODE_BINARIES="3rdparty/blobs/mainboard/google/brox/ucode-caboc.bin"
