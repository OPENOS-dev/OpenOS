CONFIG_VENDOR_GOOGLE=y
CONFIG_BOARD_GOOGLE_GLASSWAY=y
CONFIG_MAINBOARD_PART_NUMBER="Glassway_Hdmi"

# Enable Early Splash Screen
CONFIG_CHROMEOS_FW_SPLASH_SCREEN=y
CONFIG_CHROMEOS_LOGO_PATH="bootsplash_assets/chromeos_100_percent.bmp"
CONFIG_CHROMEBOOK_PLUS_LOGO_PATH="bootsplash_assets/chromebook_plus_100_percent.bmp"

# SPI Descriptor
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/google/nissa/descriptor-glassway_hdmi.bin"

# Management Engine
CONFIG_ME_BIN_PATH="3rdparty/blobs/mainboard/google/nissa/csme-glassway_hdmi.bin"

# Management Engine FW update
CONFIG_SOC_INTEL_CSE_RW_FILE="3rdparty/blobs/mainboard/google/nissa/me_rw-glassway_hdmi.bin"
CONFIG_LOCK_MANAGEMENT_ENGINE=y

# Video Blob
CONFIG_INTEL_GMA_VBT_FILE="3rdparty/blobs/mainboard/google/nissa/vbt-glassway_hdmi.bin"

# Microcode
CONFIG_CPU_UCODE_BINARIES="3rdparty/blobs/mainboard/google/nissa/ucode-glassway.bin"
