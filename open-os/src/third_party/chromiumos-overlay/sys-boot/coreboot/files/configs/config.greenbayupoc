CONFIG_VENDOR_GOOGLE=y
CONFIG_BOARD_GOOGLE_GREENBAYUPOC=y

# SPI Descriptor
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/google/brox/descriptor-greenbayupoc.bin"

# CSE data
CONFIG_ME_BIN_PATH="3rdparty/blobs/mainboard/google/brox/csme-greenbayupoc.bin"
CONFIG_SOC_INTEL_CSE_RW_FILE="3rdparty/blobs/mainboard/google/brox/me_rw-greenbayupoc.bin"

# Video Blob
CONFIG_INTEL_GMA_VBT_FILE="3rdparty/blobs/mainboard/google/brox/vbt-greenbayupoc.bin"

# Microcode
CONFIG_CPU_UCODE_BINARIES="3rdparty/blobs/mainboard/google/brox/ucode-greenbayupoc.bin"
