+++ b/system/packet/avrcp/avrcp_browse_packet.cc
@@ -18,3 +18,3 @@
 
-#include <base/sys_byteorder.h>
+#include <bit>
 
@@ -48,3 +48,3 @@ void BrowsePacketBuilder::PushHeader(const std::shared_ptr<::bluetooth::Packet>&
   AddPayloadOctets1(pkt, (uint8_t)pdu_);
-  AddPayloadOctets2(pkt, base::ByteSwap(length));
+  AddPayloadOctets2(pkt, std::byteswap(length));
 }
