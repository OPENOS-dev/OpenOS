# @ECLASS: coreboot-sdk-version.eclass
# @BLURB: Common version definition for coreboot-sdk compilers
# @DESCRIPTION:
# coreboot-sdk has a bootstrap compiler and builds for multiple architectures.
# This eclass has a common definition for toolchain versions pulled from the
# coreboot buildgcc script.

# THIS FILE IS AUTOGENERATED, DO NOT MODIFY

if [[ -z "${_ECLASS_COREBOOT_VERSION_SDK}" ]]; then
_ECLASS_COREBOOT_VERSION_SDK=1

# Check for EAPI 7+.
case "${EAPI:-0}" in
[0123456]) die "unsupported EAPI (${EAPI}) in eclass (${ECLASS})" ;;
esac

# @ECLASS-VARIABLE: GMP_VERSION
# @DESCRIPTION:
#   Version to be used for the GMP package.
export GMP_VERSION="6.3.0"

# @ECLASS-VARIABLE: GMP_SRC_URI
# @DESCRIPTION:
#   SRC_URI to be used for the GMP package.
export GMP_SRC_URI="https://ftpmirror.gnu.org/gmp/gmp-${GMP_VERSION}.tar.xz"

# @ECLASS-VARIABLE: MPFR_VERSION
# @DESCRIPTION:
#   Version to be used for the MPFR package.
export MPFR_VERSION="4.2.2"

# @ECLASS-VARIABLE: MPFR_SRC_URI
# @DESCRIPTION:
#   SRC_URI to be used for the MPFR package.
export MPFR_SRC_URI="https://ftpmirror.gnu.org/mpfr/mpfr-${MPFR_VERSION}.tar.xz"

# @ECLASS-VARIABLE: MPC_VERSION
# @DESCRIPTION:
#   Version to be used for the MPC package.
export MPC_VERSION="1.3.1"

# @ECLASS-VARIABLE: MPC_SRC_URI
# @DESCRIPTION:
#   SRC_URI to be used for the MPC package.
export MPC_SRC_URI="https://ftpmirror.gnu.org/mpc/mpc-${MPC_VERSION}.tar.gz"

# @ECLASS-VARIABLE: GCC_VERSION
# @DESCRIPTION:
#   Version to be used for the GCC package.
export GCC_VERSION="15.2.0"

# @ECLASS-VARIABLE: GCC_SRC_URI
# @DESCRIPTION:
#   SRC_URI to be used for the GCC package.
export GCC_SRC_URI="https://ftpmirror.gnu.org/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz"

# @ECLASS-VARIABLE: BINUTILS_VERSION
# @DESCRIPTION:
#   Version to be used for the BINUTILS package.
export BINUTILS_VERSION="2.45.1"

# @ECLASS-VARIABLE: BINUTILS_SRC_URI
# @DESCRIPTION:
#   SRC_URI to be used for the BINUTILS package.
export BINUTILS_SRC_URI="https://ftpmirror.gnu.org/binutils/binutils-${BINUTILS_VERSION}.tar.xz"

# @ECLASS-VARIABLE: IASL_VERSION
# @DESCRIPTION:
#   Version to be used for the IASL package.
export IASL_VERSION="20251212"

# @ECLASS-VARIABLE: IASL_SRC_URI
# @DESCRIPTION:
#   SRC_URI to be used for the IASL package.
export IASL_SRC_URI="https://downloadmirror.intel.com/871486/acpica-unix-${IASL_VERSION}.tar.gz"

fi
