# @ECLASS: cros-python311-suppress-leak-detection.eclass
# @MAINTAINER:
# ChromiumOS Build Team
# @DESCRIPTION:
# Provides functions to to suppress ASAN LeakSanitizer errors originating from
# leaks in the Python 3.11 interpreter.
#
# See b/380799956 for motivation.

if [[ -z "${_ECLASS_CROS_PYTHON311_SUPPRESS_LEAK_DETECTION}" ]]; then
_ECLASS_CROS_PYTHON311_SUPPRESS_LEAK_DETECTION=1

# Used by suppress_python311_leak_detection() and
# undo_suppress_python311_leak_detection().
__orig_lsan_options=""

# Suppresses LeakSanitizer errors originating in the Python 3.11 interpreter.
#
# Motivation: b/380799956.
#
# When running platform2.py or platform2_test.py under Python 3.11, the ASAN
# detects what appear to be memory leaks in the Python interpreter, e.g.:
#
#     Direct leak of 9240 byte(s) in 1 object(s) allocated from:
#         #0 0x5599bf48d06f in __interceptor_malloc ??:0:0
#         #1 0x7f3fc2862937 in _PyMem_SetupAllocators ??:?
#         ...
#
# As a workaround, we suppress leak detection on the /usr/bin/python3.11
# binary. Note that this does not affect leak detection on the actual
# test that is executed by platform2.py or platform2_test.py.
suppress_python311_leak_detection() {
	__orig_lsan_options="${LSAN_OPTIONS}"
	if use asan; then
		cat <<-EOF > "${T}/lsan_suppressions"
		# DO NOT EDIT - Automatically generated by platform.eclass
		leak:/usr/bin/python3.11
		EOF
		export LSAN_OPTIONS+=" suppressions=${T}/lsan_suppressions"
	fi
}

# Undoes the effect of function suppress_python311_leak_detection().
undo_suppress_python311_leak_detection() {
	if use asan; then
		export LSAN_OPTIONS="${__orig_lsan_options}"
	fi
}

fi
