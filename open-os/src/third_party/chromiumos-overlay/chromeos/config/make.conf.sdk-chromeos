# Settings that are common to all host sdks built by Googlers.  Do not place
# any board specific settings in here, or settings for cross-compiled targets.
# If you have a setting that uses all public code, use the parent dir instead.
#
# See "man 5 make.conf" and "man 5 portage" for the available options.

# TODO: Drop this!
USE="${USE} internal"

# For internal builds, automatically accept the licenses needed to
# build Chrome OS.  All Googlers have agreed to this.
ACCEPT_LICENSE="* -@EULA @CHROMEOS"

# Add internal overlays to the list.  We only use this with internal checkouts,
# so it's safe to assume these paths exist.
PORTDIR_OVERLAY="$PORTDIR_OVERLAY
	/mnt/host/source/src/private-overlays/chromeos-partner-overlay
	/mnt/host/source/src/private-overlays/chromeos-overlay
"

# Fetch files using internal boto.
FETCHCOMMAND_GS='/mnt/host/source/chromite/bin/gs_fetch_binpkg --boto /mnt/host/source/src/private-overlays/chromeos-overlay/googlestorage_account.boto "\${URI}" "\${DISTDIR}/\${FILE}"'
RESUMECOMMAND_GS="${FETCHCOMMAND_GS}"
