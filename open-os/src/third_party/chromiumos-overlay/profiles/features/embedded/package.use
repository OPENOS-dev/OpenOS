chromeos-base/chromeos-chrome	-accessibility -autotest -build_tests -chrome_remoting -reorder
chromeos-base/chromeos-init	vt
media-sound/adhd		-cras-apm -cras-ml
net-wireless/wpa_supplicant-cros -smartcard
# pam is used by login, chsh, runuser, and su. shadow provides login & chsh so
# they're disabled in util-linux. We disable su & runuser because we don't want
# anyone using them.
sys-apps/util-linux		-pam
