# proto-file: chromiumos/build/api/subtools.proto
# proto-message: chromiumos.build.api.SubtoolPackage
name: "qemu"
type: EXPORT_CIPD
max_files: 200
paths: [
  {
    input: "/usr/bin/qemu-img"
  },
  {
    input: "/usr/bin/qemu-system-aarch64"
  },
  {
    input: "/usr/bin/qemu-system-x86_64"
  },
  # glibc dynamically loads these based on /etc/nsswitch.conf, so we have to
  # copy them over manually.
  {
    input: "/lib64/libnss_*.so.2"
    dest: "lib"
  },
  {
    input: "/usr/share/qemu/**/*"
    strip_prefix_regex: "/usr/share/qemu"
    dest: "share/qemu"
    opaque_data: true
  }
]
