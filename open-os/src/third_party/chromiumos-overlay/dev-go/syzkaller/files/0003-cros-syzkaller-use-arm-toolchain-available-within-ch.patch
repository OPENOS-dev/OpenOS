From df34f7344d9a46c938fb40a57f7a99803a49f642 Mon Sep 17 00:00:00 2001
From: Zubin Mithra <zsm@chromium.org>
Date: Wed, 27 Jan 2021 10:19:31 -0800
Subject: [PATCH] cros-syzkaller: use arm toolchain available within chroot

---
 sys/targets/targets.go | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/sys/targets/targets.go b/sys/targets/targets.go
index b81b0ce70..dc9c47c84 100644
--- a/sys/targets/targets.go
+++ b/sys/targets/targets.go
@@ -229,7 +229,7 @@ var List = map[string]map[string]*Target{
 			PageSize:         4 << 10,
 			LittleEndian:     true,
 			CFlags:           []string{"-m64"},
-			Triple:           "x86_64-linux-gnu",
+			Triple:           "x86_64-cros-linux-gnu",
 			KernelArch:       "x86_64",
 			KernelHeaderArch: "x86",
 			NeedSyscallDefine: func(nr uint64) bool {
@@ -253,7 +253,7 @@ var List = map[string]map[string]*Target{
 			PtrSize:          8,
 			PageSize:         4 << 10,
 			LittleEndian:     true,
-			Triple:           "aarch64-linux-gnu",
+			Triple:           "aarch64-cros-linux-gnu",
 			KernelArch:       "arm64",
 			KernelHeaderArch: "arm64",
 		},
@@ -262,8 +262,8 @@ var List = map[string]map[string]*Target{
 			PtrSize:          4,
 			PageSize:         4 << 10,
 			LittleEndian:     true,
-			CFlags:           []string{"-D__LINUX_ARM_ARCH__=6", "-march=armv6"},
-			Triple:           "arm-linux-gnueabi",
+			CFlags:           []string{"-D__LINUX_ARM_ARCH__=6", "-march=armv8-a+crc"},
+			Triple:           "armv7a-cros-linux-gnueabihf",
 			KernelArch:       "arm",
 			KernelHeaderArch: "arm",
 		},
@@ -818,6 +818,15 @@ func (target *Target) setCompiler(clang bool) {
 			target.CCompiler = target.Triple + "-" + target.CCompiler
 		}
 	}
+	if target.OS == "linux" && target.Arch == "arm" {
+		target.CCompiler = "armv7a-cros-linux-gnueabihf-clang++"
+	}
+	if target.OS == "linux" && (target.Arch == "arm64" || target.Arch == "aarch64") {
+		target.CCompiler = "aarch64-cros-linux-gnu-clang++"
+	}
+	if target.OS == "linux" && target.Arch == "amd64" {
+		target.CCompiler = "x86_64-cros-linux-gnu-clang++"
+	}
 }
 
 func (target *Target) replaceSourceDir(param *string, sourceDir string) {
