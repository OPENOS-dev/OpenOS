From 8a962b59d09977ba44b613665962cc6c002245b5 Mon Sep 17 00:00:00 2001
From: Daan De Meyer <daan.j.demeyer@gmail.com>
Date: Fri, 24 Apr 2026 14:14:22 +0300
Subject: [PATCH] udev: Fix constness issues with newer glibc

This is a minimal backport of upstream 0bac1ed2422f ("tree-wide:
Fix constness issues with newer glibc").

glibc >= 2.41 makes strstr()/bsearch()/strchr()/strrchr()/...
type-generic and propagates const to the return, breaking our
char*/void* wrappers and a handful of libsystemd call sites under
-Werror=incompatible-pointer-types-discards-qualifiers.

The full upstream patch const_generic() macro and *_internal rename
would force a tree-wide call-site cascade, effectively a libudev and
systemd uprev, so we only patch what 249.9 actually needs to unblock
the glibc 2.43 uprev.

Signed-off-by: Adrian Ratiu <adrian.ratiu@collabora.com>
---
 src/basic/path-util.c                |  3 ++-
 src/basic/sort-util.h                |  6 +++++-
 src/basic/string-util.c              |  3 ++-
 src/basic/string-util.h              |  6 +++++-
 src/basic/time-util.c                |  2 +-
 src/basic/unit-name.c                |  2 +-
 src/libsystemd/sd-bus/sd-bus.c       | 14 +++++++++-----
 src/libsystemd/sd-device/sd-device.c |  3 ++-
 src/libsystemd/sd-hwdb/sd-hwdb.c     |  2 +-
 src/libsystemd/sd-journal/catalog.c  |  3 ++-
 src/shared/pager.c                   |  2 +-
 src/shared/socket-netlink.c          |  2 +-
 12 files changed, 32 insertions(+), 16 deletions(-)

diff --git a/src/basic/path-util.c b/src/basic/path-util.c
index 13d71ed1b6..e8118dd82f 100644
--- a/src/basic/path-util.c
+++ b/src/basic/path-util.c
@@ -1170,7 +1170,8 @@ bool path_is_normalized(const char *p) {
 }
 
 char *file_in_same_dir(const char *path, const char *filename) {
-        char *e, *ret;
+        const char *e;
+        char *ret;
         size_t k;
 
         assert(path);
diff --git a/src/basic/sort-util.h b/src/basic/sort-util.h
index 49586a4a24..22c11d5313 100644
--- a/src/basic/sort-util.h
+++ b/src/basic/sort-util.h
@@ -25,7 +25,11 @@ static inline void* bsearch_safe(const void *key, const void *base,
                 return NULL;
 
         assert(base);
-        return bsearch(key, base, nmemb, size, compar);
+        /* glibc >= 2.41 makes bsearch() type-generic via _Generic and
+         * propagates const from the base to the return type. Cast away the
+         * const here to keep this wrapper's void* return. Mirrors the cast
+         * added in bsearch_safe_internal() by upstream commit 0bac1ed2422f. */
+        return (void*) bsearch(key, base, nmemb, size, compar);
 }
 
 #define typesafe_bsearch(k, b, n, func)                                 \
diff --git a/src/basic/string-util.c b/src/basic/string-util.c
index a645958d38..b6e34899f0 100644
--- a/src/basic/string-util.c
+++ b/src/basic/string-util.c
@@ -895,7 +895,8 @@ char *strrep(const char *s, unsigned n) {
 }
 
 int split_pair(const char *s, const char *sep, char **l, char **r) {
-        char *x, *a, *b;
+        const char *x;
+        char *a, *b;
 
         assert(s);
         assert(sep);
diff --git a/src/basic/string-util.h b/src/basic/string-util.h
index 9155e50ba8..3e7524b9bc 100644
--- a/src/basic/string-util.h
+++ b/src/basic/string-util.h
@@ -25,7 +25,11 @@
 static inline char* strstr_ptr(const char *haystack, const char *needle) {
         if (!haystack || !needle)
                 return NULL;
-        return strstr(haystack, needle);
+        /* glibc >= 2.41 makes strstr() type-generic via _Generic and propagates
+         * const from the haystack to the return type. Cast away the const here
+         * to keep this wrapper's char* return. Mirrors the cast added in the
+         * *_internal helpers by upstream commit 0bac1ed2422f. */
+        return (char*) strstr(haystack, needle);
 }
 
 static inline const char* strempty(const char *s) {
diff --git a/src/basic/time-util.c b/src/basic/time-util.c
