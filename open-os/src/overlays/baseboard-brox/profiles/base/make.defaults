# Initial value just for style purposes.
LINUX_FIRMWARE=""
USE=""

# Specify default kernel
USE="${USE} -kernel-5_10 kernel-6_6"

# Indicate hybrid architecture utilizing performance and efficient cores.
USE="${USE} big_little"

# WiFi firmware for GfP2
LINUX_FIRMWARE="${LINUX_FIRMWARE} iwlwifi-so"

# BT firmware for GfP2
LINUX_FIRMWARE="${LINUX_FIRMWARE} ibt_ax211"

# WiFi firmware for GaP2
LINUX_FIRMWARE="${LINUX_FIRMWARE} iwlwifi-gl"

# Enable tpm
USE="${USE} -tpm tpm2 ti50_onboard"

# Add EC logging
USE="${USE} eclog"

# Build kernel with serial driver
USE="${USE} pcserial"
USE="${USE} tty_console_ttyS0"

# Enable serial console
TTY_CONSOLE="ttyS0"

# Enable NVMe utility
USE="${USE} nvme"

# Allow Chrome to use Tablet mode
USE="${USE} touchview"

# Enable Type-C daemon
USE="${USE} typecd"

# Enable external PCI device security
USE="${USE} pciguard"

# Enable eMMC tools
USE="${USE} mmc"

# Enable miniOS support
USE="${USE} minios"

# Enable LVM stateful partition.
USE="${USE} lvm_stateful_partition"

# Enable LVM application containers.
USE="${USE} lvm_application_containers"

# Build ufs tools
USE="${USE} ufs"

# Use Vulkan for raster/composite in Chrome
USE="${USE} vulkan_chrome"
