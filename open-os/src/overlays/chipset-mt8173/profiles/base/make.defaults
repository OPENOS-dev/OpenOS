CHROMEOS_KERNEL_SPLITCONFIG="chromiumos-mediatek"
CHROMEOS_KERNEL_ARCH="arm64"

# Initial value just for style purposes.
LINUX_FIRMWARE=""
USE=""

BOARD_COMPILER_FLAGS="-march=armv8-a+crc+crypto -mtune=cortex-a57 -ftree-vectorize"
BOARD_RUSTFLAGS="-Ctarget-feature=+armv8-a,+crc,+aes,+neon,+sha2"
USE="${USE} march_armv8-a"

# Turn on the video cards this board uses.
VIDEO_CARDS="mediatek powervr"

USE="${USE} mt8173"
USE="${USE} mediatek_cpu"

# MT8173 VPU firmware
LINUX_FIRMWARE="${LINUX_FIRMWARE} mt8173-vpu"

USE="${USE} uprev-4-to-5"
USE="${USE} device_tree -dt_compression hardfp kernel-5_15"
USE="${USE} powerd_manual_eventlog_add neon -opengl opengles"
USE="${USE} watchdog"

# TODO(b/194744558): Disable CrOS video decoder at ARC.
USE="${USE} arc_disable_cros_video_decoder"

# MT8173 minigbm
USE="${USE} minigbm_platform_mt8173"

# Enable HW codecs using V4L2 API.
USE="${USE} v4l2_codec"

# Enable GpuMemoryBuffers backed by dma-bufs.
USE="${USE} native_gpu_memory_buffers"

# Use legacy pre-Groot UI for initramfs and init script screens.
USE="${USE} legacy_firmware_ui"

USE="${USE} vulkan"

# Set raster thread number=2 and schedule non-urgent tasks to small cores
USE="${USE} big_little"
