ACTION=="add", ENV{ID_MODEL}=="Hammer", SUBSYSTEM=="usb", ATTRS{idVendor}=="18d1", \
  DEVPATH=="/devices/platform/soc/11280000.usb/usb3/3-1/3-1.*", \
  RUN+="/sbin/initctl emit --no-wait hammer-device-added"

ACTION=="add", ENV{ID_MODEL}=="Hammer", SUBSYSTEM=="usb", ATTRS{idVendor}=="18d1", \
  DEVPATH=="/devices/platform/soc/11200000.usb/usb1/1-1/1-1.*", \
  RUN+="/sbin/initctl emit --no-wait hammer-device-added"

ACTION=="add", ENV{ID_MODEL}=="Spikyrock", SUBSYSTEM=="usb", ATTRS{idVendor}=="18d1", \
  DEVPATH=="/devices/platform/soc/11200000.usb/usb1/1-1/1-1.*", \
  RUN+="/sbin/initctl emit --no-wait hammer-device-added"

ACTION=="add", ENV{ID_MODEL}=="Whitebeard", SUBSYSTEM=="usb", ATTRS{idVendor}=="18d1", \
  DEVPATH=="/devices/platform/soc/11200000.usb/usb1/1-1/1-1.*", \
  RUN+="/sbin/initctl emit --no-wait hammer-device-added"
