# M.2 modem card reset on net WWAN_RTS_L is connected to ISH_UART0_RTSB
# and is at offset 111.
 ACTION=="add", DEVPATH=="*/INT34BB:00/gpiochip*/gpio/*", \
   RUN+="/lib/udev/chown-usb-modem-gpio.sh \"$sys/$devpath\" \"INT34BB:00\" 111"
