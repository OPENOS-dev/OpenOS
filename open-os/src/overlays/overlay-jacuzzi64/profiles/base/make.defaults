# Initial value just for style purposes.
USE=""

USE="${USE} jacuzzi64"
USE="${USE} -tpm tpm2"

# Disable features for jacuzzi64
USE="${USE} -bootimage -coreboot -cros_ec"

USE="${USE} -mosys_platform_generic mosys_platform_kukui"

BOARD_COMPILER_FLAGS="-march=armv8-a+crc+crypto -mtune=cortex-a53 -mfpu=crypto-neon-fp-armv8 -mfloat-abi=hard -ftree-vectorize"
BOARD_RUSTFLAGS="-Ctarget-feature=+armv8-a,+crc,+aes,+neon,+sha2"
USE="${USE} march_armv8-a"

VIDEO_CARDS="mediatek panfrost"

# Include the elan_i2chid firmware updating tool
INPUT_DEVICES="${INPUT_DEVICES} elan_i2chid"
# Include the g2touch firmware updating tool
INPUT_DEVICES="${INPUT_DEVICES} g2touch"
# Include the weida firmware updating tool
INPUT_DEVICES="${INPUT_DEVICES} weida"
