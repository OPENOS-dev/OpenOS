{
  "distribution": {
    "ready_mode": true,
    "skip_first_run_ui": true,
    "show_welcome_page": false,
    "suppress_first_run_default_browser_prompt": true
  },
  "session": {
    "restore_on_startup": 4,
    "startup_urls": [
      "https://openos.org/welcome"
    ]
  },
  "browser": {
    "check_default_browser": false,
    "default_search_provider": {
      "enabled": true,
      "name": "Bing",
      "keyword": "bing.com",
      "search_url": "https://www.bing.com/search?q={searchTerms}",
      "suggest_url": "https://www.bing.com/osjson.aspx?query={searchTerms}",
      "image_url": "https://www.bing.com/images/search?q={searchTerms}",
      "new_tab_url": "https://www.bing.com/chrome/newtab",
      "favicon_url": "https://www.bing.com/favicon.ico",
      "encoding": "UTF-8",
      "is_default": true
    }
  },
  "homepage": "https://openos.org",
  "homepage_is_newtabpage": false
}
