# Initial value just for style purposes.
LINUX_FIRMWARE=""
SOF_TARGETS=""
USE=""

CHROMEOS_KERNEL_SPLITCONFIG="chromeos-intel-pineview"
CHROMEOS_KERNEL_ARCH="x86_64"

# NOTE(b/406205536): gfni is currently disabled by default due to a mix of:
# - LLVM's strong tendencies to use it when it's enabled
# - Instructions being new enough that many of our builders SIGILL on them
# These have consistently been popping up in paths covered by unittests,
# especially in `.a` and `.so` files, so the traditional practice of
# `use test && append-cppflags -march=x86-64-v2` isn't very effective.
#
# These can always be overridden per-build by adding `-mgfni` or
# `-Ctarget-feature=+gfni`, provided your code is guarded by runtime checks.
BOARD_COMPILER_FLAGS="-march=alderlake -mno-gfni"
BOARD_RUSTFLAGS="-Ctarget-cpu=alderlake -Ctarget-feature=-gfni"
USE="${USE} march_alderlake"

# Specify default kernel
USE="${USE} kernel-5_10"

# Enable DPTF
USE="${USE} dptf"

# Identify the vendor
USE="${USE} intel_cpu"

# Enable GpuMemoryBuffers backed by dma-bufs.
USE="${USE} native_gpu_memory_buffers"

# Build IPU6EP variant in cros-camera-hal-intel-ipu6.
USE="${USE} ipu6ep"

# Enable fscrypt v2 usage on 5.4+
USE="${USE} direncription_allow_v2"

# Enable Intel media-driver
USE="${USE} -video_cards_i965 video_cards_iHD video_cards_iHD_g12"


# Use GuC and HuC
USE="${USE} builtin_fw_guc_adl builtin_fw_huc_adl"

# i915 firmware for ADL
# i915_tgl needed to add TGL GuC and HuC
LINUX_FIRMWARE="${LINUX_FIRMWARE} i915_tgl"
LINUX_FIRMWARE="${LINUX_FIRMWARE} i915_adl"

# Enable adl firmware target for sound open firmware
SOF_TARGETS="adl"

# Enable DRM/KMS atomic api
USE="${USE} drm_atomic"

# Enable vulkan
USE="${USE} vulkan"

# Enable android_aep
USE="${USE} android_aep"

# Enable VMs
USE="${USE} kvm_host crosvm-gpu virtio_gpu"

# Allows Chrome to start in the presence of multiple threads.
USE="${USE} gpu_sandbox_start_early"

# Enable clvk
USE="${USE} clvk"

# Enable ARCVM direct VAAPI decoding
USE="${USE} crosvm-video-vaapi"

# Change the default ARCVM decoder to libvda-vd instead of libvda.
USE="${USE} crosvm-virtio-video-vd"

# Bigcore profiles are more appropriate than atom on adl devices.
AFDO_PROFILE_SOURCE="bigcore"
