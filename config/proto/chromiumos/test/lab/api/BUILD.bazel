load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "api_proto",
    srcs = glob(["*.proto"]),
    visibility = ["//visibility:public"],
    deps = [
        "//chromiumos/config/api:api_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
)

go_proto_library(
    name = "api_go_proto",
    compilers = ["@io_bazel_rules_go//proto:go_grpc"],
    importpath = "go.chromium.org/chromiumos/config/go/test/lab/api",
    proto = ":api_proto",
    visibility = ["//visibility:public"],
    deps = ["//chromiumos/config/api"],
)

go_library(
    name = "api",
    embed = [":api_go_proto"],
    importpath = "go.chromium.org/chromiumos/config/go/test/lab/api",
    visibility = ["//visibility:public"],
)
