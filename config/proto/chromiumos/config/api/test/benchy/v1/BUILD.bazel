load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "benchy_proto",
    srcs = ["plan.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "benchy_go_proto",
    importpath = "go.chromium.org/chromiumos/config/go/api/test/benchy/v1",
    proto = ":benchy_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "benchy",
    embed = [":benchy_go_proto"],
    importpath = "go.chromium.org/chromiumos/config/go/api/test/benchy/v1",
    visibility = ["//visibility:public"],
)
