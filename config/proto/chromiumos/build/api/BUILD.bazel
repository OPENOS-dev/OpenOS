load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "api_proto",
    srcs = [
        "ash_chrome_config.proto",
        "container_metadata.proto",
        "dlc.proto",
        "factory.proto",
        "firmware_config.proto",
        "metadata_service.proto",
        "portage.proto",
        "software_attribute.proto",
        "software_bundle.proto",
        "subtools.proto",
        "system_image.proto",
        "test.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//chromiumos:_go_proto",
        "//chromiumos/config/api:api_proto",
    ],
)

go_proto_library(
    name = "api_go_proto",
    compilers = ["@io_bazel_rules_go//proto:go_grpc"],
    importpath = "go.chromium.org/chromiumos/config/go/build/api",
    proto = ":api_proto",
    visibility = ["//visibility:public"],
    deps = [
        "//chromiumos:go",
        "//chromiumos/config/api",
    ],
)

go_library(
    name = "api",
    embed = [":api_go_proto"],
    importpath = "go.chromium.org/chromiumos/config/go/build/api",
    visibility = ["//visibility:public"],
)
