load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "payload_proto",
    srcs = [
        "config_bundle.proto",
        "flat_config.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//chromiumos/config/api:api_proto",
        "//chromiumos/config/api/software:software_proto",
    ],
)

go_proto_library(
    name = "payload_go_proto",
    importpath = "go.chromium.org/chromiumos/config/go/payload",
    proto = ":payload_proto",
    visibility = ["//visibility:public"],
    deps = [
        "//chromiumos/config/api",
        "//chromiumos/config/api/software",
    ],
)

go_library(
    name = "payload",
    embed = [":payload_go_proto"],
    importpath = "go.chromium.org/chromiumos/config/go/payload",
    visibility = ["//visibility:public"],
)
