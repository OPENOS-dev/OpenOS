load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "testdata_proto",
    srcs = ["public_replication_testdata.proto"],
    visibility = ["//visibility:public"],
    deps = ["//chromiumos/config/public_replication:public_replication_proto"],
)

go_proto_library(
    name = "testdata_go_proto",
    importpath = "go.chromium.org/chromiumos/config/go/public_replication/testdata",
    proto = ":testdata_proto",
    visibility = ["//visibility:public"],
    deps = ["//chromiumos/config/public_replication"],
)

go_library(
    name = "testdata",
    embed = [":testdata_go_proto"],
    importpath = "go.chromium.org/chromiumos/config/go/public_replication/testdata",
    visibility = ["//visibility:public"],
)
