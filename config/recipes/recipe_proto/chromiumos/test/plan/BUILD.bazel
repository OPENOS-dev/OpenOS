load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "plan_proto",
    srcs = ["source_test_plan.proto"],
    visibility = ["//visibility:public"],
    deps = ["//chromiumos/test/api:api_proto"],
)

go_proto_library(
    name = "plan_go_proto",
    importpath = "go.chromium.org/chromiumos/config/go/test/plan",
    proto = ":plan_proto",
    visibility = ["//visibility:public"],
    deps = ["//chromiumos/test/api"],
)

go_library(
    name = "plan",
    embed = [":plan_go_proto"],
    importpath = "go.chromium.org/chromiumos/config/go/test/plan",
    visibility = ["//visibility:public"],
)
