load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "test_api_v1_proto",
    srcs = ["plan.proto"],
    visibility = ["//visibility:public"],
    deps = ["//chromiumos/test/api:api_proto"],
)

go_proto_library(
    name = "test_api_v1_go_proto",
    importpath = "go.chromium.org/chromiumos/config/go/test/api/v1",
    proto = ":test_api_v1_proto",
    visibility = ["//visibility:public"],
    deps = ["//chromiumos/test/api"],
)

go_library(
    name = "api",
    embed = [":test_api_v1_go_proto"],
    importpath = "go.chromium.org/chromiumos/config/go/test/api/v1",
    visibility = ["//visibility:public"],
)
